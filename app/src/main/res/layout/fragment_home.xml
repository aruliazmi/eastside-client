<?xml version="1.0" encoding="utf-8"?>
<!--
  Home — Eastside Client.

  Referensi tata letak: kartu "NAMA PEMAIN" + kartu "SERVER SAAT INI" di
  tengah, satu tombol utama besar di bawahnya, tautan kecil di kaki layar.
  Bedanya di sini: server tidak dikunci — kartu server membuka daftar server.

  Aksen tunggal: kuningan (es_brass). Status memakai es_live/es_dead, tidak
  pernah dekoratif.

  Semua android:id lama dipertahankan; yang baru ditambahkan di bawah.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/es_asphalt">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/es_gutter"
            android:paddingTop="26dp"
            android:paddingBottom="28dp">

            <!-- ===================== MASTHEAD ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Tanda: blok kuningan, bukan logo ilustrasi. -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="34dp"
                    android:background="@color/es_brass" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_black"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.03"
                        android:text="EASTSIDE"
                        android:textColor="@color/es_ink"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/plex_mono_medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.1"
                        android:text="STORIES · MOBILE"
                        android:textColor="@color/es_ink_faint"
                        android:textSize="9sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_header_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Pengaturan"
                    android:padding="9dp"
                    app:srcCompat="@drawable/ic_gear"
                    app:tint="@color/es_ink_dim" />
            </LinearLayout>

            <View
                style="@style/EsRule"
                android:layout_marginTop="20dp" />

            <!--
              Isi utama diberi weight=1 plus gravity center_vertical supaya kartu
              pemain, kartu server dan tombol LOGIN duduk di tengah layar, bukan
              menempel di bawah masthead ketika tidak ada blok status aset.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

            <!-- ===================== KARTU PEMAIN ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/es_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/EsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama pemain" />

                    <EditText
                        android:id="@+id/et_player_nickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@null"
                        android:fontFamily="@font/montserrat_bold"
                        android:hint="Nama_Karakter"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName"
                        android:maxLength="24"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/es_ink"
                        android:textColorHint="@color/es_ink_ghost"
                        android:textSize="18sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_edit_nickname"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ubah nama"
                    android:padding="8dp"
                    app:srcCompat="@drawable/ic_pencil"
                    app:tint="@color/es_brass" />
            </LinearLayout>

            <!-- ===================== KARTU SERVER ===================== -->
            <!-- Klik membuka daftar server. Ini yang menggantikan hardcode. -->
            <LinearLayout
                android:id="@+id/card_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/es_card_accent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/EsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Server" />

                        <View
                            android:id="@+id/dot_server"
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_dot_gray" />

                        <TextView
                            android:id="@+id/tv_server_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/plex_mono_semibold"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.12"
                            android:text="MEMUAT"
                            android:textColor="@color/es_ink_faint"
                            android:textSize="8.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_server_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Eastside Stories"
                        android:textColor="@color/es_ink"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_server_endpoint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plex_mono_medium"
                            android:includeFontPadding="false"
                            android:text="0.0.0.0:7777"
                            android:textColor="@color/es_ink_faint"
                            android:textSize="10.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:text="·"
                            android:textColor="@color/es_ink_ghost"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_server_players"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plex_mono_semibold"
                            android:includeFontPadding="false"
                            android:text="-- / --"
                            android:textColor="@color/es_brass"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_server_ping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/plex_mono_medium"
                            android:includeFontPadding="false"
                            android:text="-- ms"
                            android:textColor="@color/es_ink_ghost"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Pilih server"
                    app:srcCompat="@drawable/ic_chevron_right"
                    app:tint="@color/es_brass" />
            </LinearLayout>

            <!-- ===================== AKSI UTAMA ===================== -->
            <Button
                android:id="@+id/btn_quick_play"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/es_btn_primary"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.14"
                android:text="LOGIN"
                android:textAllCaps="true"
                android:textColor="@color/es_asphalt"
                android:textSize="14sp"
                app:backgroundTint="@null" />

            </LinearLayout>

            <!--
              Blok "ASET GAME" (status verifikasi + tombol VERIFIKASI/UNDUH +
              path file) dihapus dari layar ini. Semua fungsinya sudah ada di
              tab ATUR: SettingsFragment memverifikasi lewat GameDataVerifier
              dan memperbaiki lewat GameDataRepair, jadi menampilkannya lagi di
              beranda hanya menduplikasi kontrol yang sama.
            -->

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
