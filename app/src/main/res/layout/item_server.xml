<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris server. Dipakai dialog pemilih server. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/es_row_selectable"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_row"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_dot_gray" />

            <TextView
                android:id="@+id/tv_row_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/montserrat_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Server"
                android:textColor="@color/es_ink"
                android:textSize="13.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_row_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="middle"
            android:fontFamily="@font/plex_mono_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0.0.0.0:7777"
            android:textColor="@color/es_ink_ghost"
            android:textSize="9.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_row_players"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plex_mono_semibold"
        android:includeFontPadding="false"
        android:text="-- / --"
        android:textColor="@color/es_ink_dim"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/tv_row_ping"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plex_mono_medium"
        android:gravity="end"
        android:includeFontPadding="false"
        android:text="-- ms"
        android:textColor="@color/es_ink_faint"
        android:textSize="10.5sp" />

    <ImageView
        android:id="@+id/iv_row_delete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Hapus server"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_trash"
        app:tint="@color/es_dead" />
</LinearLayout>
