<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu baris berkas. Tanpa card: hanya ruang dan satu garis bawah tipis
  yang digambar oleh pemisah RecyclerView. Ikon kecil, nama mono.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="14dp"
    android:paddingHorizontal="2dp">

    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="17dp"
        android:layout_height="17dp"
        app:srcCompat="@drawable/ic_folder_nav"
        app:tint="@color/es_ink_faint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_mono_semibold"
            android:includeFontPadding="false"
            android:text="sa-mp.cfg"
            android:textColor="@color/es_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_file_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/plex_mono_medium"
            android:includeFontPadding="false"
            android:text="1.2 KB"
            android:textColor="@color/es_ink_ghost"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_file_delete"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="5dp"
        app:srcCompat="@drawable/ic_delete"
        app:tint="@color/es_ink_ghost" />

</LinearLayout>
