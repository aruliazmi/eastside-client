<?xml version="1.0" encoding="utf-8"?>
<!-- Pemilih server: panel gelap, header judul + aksi tambah, daftar baris.

     Baris sengaja bukan kartu: pemisahnya satu garis tipis. Ini yang membuat
     daftar terasa seperti daftar, bukan tumpukan kotak.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/es_sheet"
    android:orientation="vertical"
    android:paddingTop="18dp"
    android:paddingBottom="10dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_black"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="PILIH SERVER"
                android:textColor="@color/es_ink"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tv_server_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/plex_mono_medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="0 TERSIMPAN"
                android:textColor="@color/es_ink_faint"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_add_server"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tambah server"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_plus"
            app:tint="@color/es_brass" />

        <TextView
            android:id="@+id/tv_close_servers"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/plex_mono_semibold"
            android:gravity="center_vertical"
            android:letterSpacing="0.08"
            android:paddingHorizontal="10dp"
            android:text="TUTUP"
            android:textColor="@color/es_brass"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        style="@style/EsRule"
        android:layout_marginTop="14dp" />

    <!-- Kolom: identifier & angka, jadi mono. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/EsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Server" />

        <TextView
            style="@style/EsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pemain" />

        <TextView
            style="@style/EsLabel"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Ping" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_server_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </ScrollView>

</LinearLayout>
