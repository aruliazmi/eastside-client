<?xml version="1.0" encoding="utf-8"?>
<!--
  Shell aplikasi: viewpager + nav bawah.

  Nav v2: tiga tab sama lebar, ikon 23dp di atas label permanen 9sp. Status
  aktif ditandai dua hal sekaligus — warna kuningan pada ikon+label, dan garis
  penanda 2dp di tepi atas tab. Label selalu ada supaya tinggi tidak melompat
  antar tab. Tidak ada pill berisi warna penuh, tidak ada shadow.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@color/es_asphalt"
    android:keepScreenOn="true">

    <com.sampmobile.xyvern.launcher.util.ViewPagerWithoutSwipe
        android:id="@+id/fragment_place"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/nav_rule"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/nav_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/es_rule_strong"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav" />

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/es_surface_sunken"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/ind_home"
                android:layout_width="26dp"
                android:layout_height="2dp"
                android:layout_marginBottom="9dp"
                android:background="@color/es_brass" />

            <ImageView
                android:id="@+id/iv_home"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Kota"
                app:srcCompat="@drawable/ic_mainmenu"
                app:tint="@color/es_brass" />

            <TextView
                android:id="@+id/tv_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/plex_mono_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:text="KOTA"
                android:textAllCaps="true"
                android:textColor="@color/es_brass"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_files"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/ind_files"
                android:layout_width="26dp"
                android:layout_height="2dp"
                android:layout_marginBottom="9dp"
                android:background="@android:color/transparent" />

            <ImageView
                android:id="@+id/iv_files"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Berkas"
                app:srcCompat="@drawable/ic_folder_nav"
                app:tint="@color/es_ink_ghost" />

            <TextView
                android:id="@+id/tv_files"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/plex_mono_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:text="BERKAS"
                android:textAllCaps="true"
                android:textColor="@color/es_ink_ghost"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/ind_settings"
                android:layout_width="26dp"
                android:layout_height="2dp"
                android:layout_marginBottom="9dp"
                android:background="@android:color/transparent" />

            <ImageView
                android:id="@+id/iv_settings"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="Atur"
                app:srcCompat="@drawable/ic_settingsmenu"
                app:tint="@color/es_ink_ghost" />

            <TextView
                android:id="@+id/tv_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/plex_mono_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:text="ATUR"
                android:textAllCaps="true"
                android:textColor="@color/es_ink_ghost"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
