<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash saat engine dimuat.

  Bukan logo besar di tengah + progress bar melayang di pojok. Ini
  identitas kota: nama, satu garis kuningan, satu progres tipis.
  Tidak ada yang bergerak selain progres.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/es_asphalt">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.46">

        <TextView
            style="@style/EsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat kota" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/montserrat_black"
            android:includeFontPadding="false"
            android:letterSpacing="-0.035"
            android:text="EASTSIDE"
            android:textColor="@color/es_ink"
            android:textSize="34sp" />

        <View
            android:layout_width="38dp"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:background="@color/es_brass" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar2"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginHorizontal="72dp"
        android:layout_marginBottom="54dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/download_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
