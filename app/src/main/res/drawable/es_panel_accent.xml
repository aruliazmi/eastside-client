<?xml version="1.0" encoding="utf-8"?>
<!-- Kotak status: hanya untuk status server. Garis kiri 3dp sebagai penanda,
     bukan fill penuh. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/es_surface_raised" />
            <stroke android:width="1dp" android:color="@color/es_rule" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/es_brass" />
        </shape>
    </item>
</layer-list>
