<?xml version="1.0" encoding="utf-8"?>
<!-- Bingkai dialog in-game: permukaan aspal, garis tipis.
     Dimensi dipertahankan; hanya warna yang mengikuti token baru,
     supaya tidak menggeser tuning DialogManager. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/es_surface_raised" />
            <stroke
                android:width="1.2dp"
                android:color="@color/es_rule_strong" />
        </shape>
    </item>
</layer-list>
