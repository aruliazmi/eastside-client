<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu yang bisa diketuk untuk memilih server: garis kiri kuningan 3dp.
     Sama seperti panel status lama, supaya bahasa visualnya konsisten. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/es_surface_raised" />
            <stroke android:width="1dp" android:color="@color/es_rule_strong" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/es_brass" />
        </shape>
    </item>
</layer-list>
