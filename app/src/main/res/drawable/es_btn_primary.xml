<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol utama: blok kuningan solid. Tanpa gradient, tanpa glow.
     Tekstur datang dari tipografi dan kontras, bukan dari efek. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33F2EDE4">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/es_brass" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</ripple>
