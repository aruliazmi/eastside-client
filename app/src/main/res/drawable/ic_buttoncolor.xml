<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol dialog: kuningan solid, state pressed sedikit lebih gelap.
     Tanpa gradient, tanpa radius penuh. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/es_brass_dim" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/es_brass" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
