<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol sekunder: hanya garis, tanpa isi. Border 1dp lebih tipis dari
     tombol utama supaya hierarki jelas tanpa perlu warna berbeda. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22F2EDE4">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/es_rule_strong" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</ripple>
