<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SAMPLauncher" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.SAMPLauncher.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.SAMPLauncher.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.SAMPLauncher.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Dialog gelap untuk launcher.

         AndroidManifest memakai Theme.AppCompat.Light.NoActionBar, jadi
         AlertDialog bawaan selalu putih: kotak isian gelap di atas latar putih,
         teks "Simpan"/"Batal" hitam, dan sudut yang tidak senada dengan
         es_tokens. ThemeOverlay ini dipasang lewat ContextThemeWrapper saat
         dialog dibuat. -->
    <style name="Theme.SAMPLauncher.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/es_brass</item>
        <item name="android:textColorPrimary">@color/es_ink</item>
        <item name="android:textColorSecondary">@color/es_ink_dim</item>
        <item name="android:background">@color/es_surface</item>
        <item name="android:windowBackground">@color/es_surface</item>
        <item name="android:colorBackground">@color/es_surface</item>
        <item name="android:textColorAlertDialogListItem">@color/es_ink</item>
        <item name="alertDialogTheme">@style/Theme.SAMPLauncher.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/EsDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/EsDialogButton</item>
    </style>

    <style name="EsDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/es_brass</item>
        <item name="android:fontFamily">@font/plex_mono_semibold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>